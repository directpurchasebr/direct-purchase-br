{
    "server": {
        "port": 5488
    },
    "store": {
        "provider": "fs"
    },
    "templateEngine": "handlebars",
    "recipe": "chrome-pdf",
    "chrome": {
        "launchOptions": {
            "args": [
                "--no-sandbox",
                "--disable-setuid-sandbox",
                "--disable-dev-shm-usage",
                "--disable-accelerated-2d-canvas",
                "--disable-gpu",
                "--headless=new",
                "--no-first-run",
                "--no-zygote"
            ]
        }
    },
    "studio": {
        "enabled": false
    },
    "extensions": {
        "scripts": {
            "timeout": 5000
        }
    },
    "tasks": {
        "strategy": "http-server",
        "timeout": 30000,
        "maxConcurrentTasks": 2
    }
}